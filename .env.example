# Copy this file to .env and fill in your key (never commit .env)
GEMINI_API_KEY=paste-your-key-here

# Optional: models tried in order (first available / not rate-limited wins)
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash

# Optional: use Postgres (e.g. Neon) instead of the local SQLite file
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional business-rule overrides
# AMOUNT_TOLERANCE_PCT=1
# AMOUNT_TOLERANCE_ABS=500
# AUTO_APPROVE_LIMIT=500000
